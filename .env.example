# Copia este archivo como `.env` (está en .gitignore y nunca se sube al repo).
# En un teléfono físico usa la IP LAN de tu PC; `localhost` sería el propio teléfono.
# KEYCLOAK_ISSUER_URL debe ser IDÉNTICO a JWT_ISSUER_URI del back.
KEYCLOAK_ISSUER_URL=http://<IP-LAN-DE-TU-PC>:8080/realms/que-hay-pa-dev
API_BASE_URL=http://<IP-LAN-DE-TU-PC>:5001
