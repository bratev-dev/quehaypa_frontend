# Copia este archivo como `.env` (está en .gitignore y nunca se sube al repo).
# En un teléfono físico usa la IP LAN de tu PC; `localhost` sería el propio teléfono.
# KEYCLOAK_ISSUER_URL debe ser IDÉNTICO a JWT_ISSUER_URI del api-gateway.
# La API entra únicamente por el gateway (:8080); Keycloak corre en :8090.
KEYCLOAK_ISSUER_URL=http://<IP-LAN-DE-TU-PC>:8090/realms/que-hay-pa-dev
API_BASE_URL=http://<IP-LAN-DE-TU-PC>:8080
