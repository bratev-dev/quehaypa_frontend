# Configuración pública del backend desplegado. Copiar como .env (ignorado por Git).
# Las peticiones REST pasan únicamente por el gateway HTTPS.
API_BASE_URL=https://api-gateway-production-b74fe.up.railway.app
KEYCLOAK_ISSUER_URL=https://keycloak-production-58e17.up.railway.app/realms/que-hay-pa-dev

# Para desarrollo local, sustituir API_BASE_URL por la IP LAN del gateway.
# --dart-define=API_BASE_URL=... y --dart-define=KEYCLOAK_ISSUER_URL=...
# tienen precedencia sobre este archivo. No añadir secretos ni tokens.
